# macOS
.DS_Store
# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/
# Swift Package Manager
.build/
.swiftpm/
# Secrets
*.p8
*.p12
*.mobileprovision
.env
.env.*

# Реальные VPN-профили: содержат приватный ключ и tls-auth static key.
# В репозиторий не попадают никогда. Тестовые фикстуры — только анонимизированные.
*.ovpn
*.conf

# Исключение ровно для одной фикстуры: её ключи сгенерированы заново и не
# совпадают с боевыми (проверено сверкой тел PEM). Без исключения тест разбора
# боевого профиля не сможет лежать в репозитории — правило выше блокирует всё.
!android/core/config/src/test/resources/anonymized-production.ovpn

# Материал, из которого собрана фикстура: приватный ключ CA, хотя и поддельный.
/.fixture/

# Android / Gradle
.gradle/
android/.gradle/
android/local.properties
android/build/
android/**/build/
android/.idea/
android/captures/
.kotlin/
# Ключ подписи release-APK. Его потеря = невозможность обновить установленное
# приложение, поэтому он хранится в GitHub Secrets и в бэкапе, но не в репозитории.
*.jks
*.keystore
android/app/release/

# Черновые файлы разбора CI (ответы GitHub API, логи прогонов). В репозитории
# им не место: это мусор от отладки, а не часть проекта.
/j.json
/a.json
/r.json
/cs.json
/cr.json
/ra.json
/jobs.json
/log.txt
/err.txt
/gradle-test.log
/instrumented.log
/failures.txt
/*.log

# Временные каталоги для проверки артефактов и разбора CI. В репозитории им не место.
/.apkcheck/
/.scratch/

# Локальные инструменты (platform-tools/adb). Ставятся скачиванием, не через git.
/.tools/

# Выгруженный артефакт движка (48 МБ .so + сгенерированные классы). Скачивается
# по необходимости из CI, в репозитории ему не место.
/.engine/

# Собранный движок: .so (~50 МБ на архитектуру) и 42 сгенерированных Java-класса.
# Приходит артефактом из джобы `engine` и раскладывается в дерево модуля.
# В репозитории не хранится: собирается заново, а размер делает клон тяжёлым.
/android/vpnengine/src/main/jniLibs/
/android/vpnengine/src/main/java/

# Выгруженный артефакт движка для сверки сигнатур SWIG (42 класса + .so).
/.chk/
/.profile-directives.txt
