<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Установка скачанного обновления: система спросит подтверждение сама. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      android:allowBackup="false" — осознанно.
      В приложении лежат сессия и профиль с приватным ключом. Системный автобэкап
      утащил бы их в облако Google, чего для privacy-инструмента допускать нельзя.
      Смена устройства = повторный вход через бота, а не восстановление ключей.

      allowBackup одного НЕДОСТАТОЧНО (аудит 2026-10-03): начиная с Android 12
      device-to-device перенос управляется отдельно, а часть OEM игнорирует сам
      флаг. Поэтому дополнительно заданы dataExtractionRules и fullBackupContent —
      оба запрещают и облако, и прямой перенос на новое устройство.
    -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.VpnApp">

        <!-- APK отдаётся установщику как content:// — file:// на Android 7+
             бросает FileUriExposedException. Каталог ограничен кешем. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.VpnApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep link для входа через Telegram: t.me/bot?start=login_<public_code>
              На Android ссылка открывается через намерение, приложение ловит её здесь.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vpnapp" android:host="login" />
            </intent-filter>
        </activity>
    </application>

</manifest>
