<?xml version="1.0" encoding="utf-8"?>
<!--
  Иконка приложения: щит на тёмном фоне.

  Форма и цвета взяты из самой системы приложения — щит с экрана подключения и
  палитра :core:ui (фон Void #0A0C10, акцент Ice #6FB3FF). Иконка не придумывает
  новый язык: она повторяет то, что человек уже видит внутри.

  Adaptive icon вместо PNG: minSdk 26, то есть adaptive поддерживается везде, где
  приложение вообще запускается. Это избавляет от шести растровых размеров,
  которые пришлось бы держать в согласии друг с другом.

  Foreground намеренно мал (54dp из 108dp): система обрезает иконку до круга,
  квадрата или «капли» в зависимости от лончера, и слишком крупный рисунок
  потерял бы края щита при круглой маске.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
