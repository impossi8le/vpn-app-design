<!--
  Минимальный набор для системных элементов окна. Полная палитра — в :core:ui
  (Compose-токены), здесь только то, что нужно до инициализации Compose.

  Красный зарезервирован под реальную опасность, янтарный — под процесс
  подключения. Эти два цвета НЕ живут здесь: они принадлежат одному экрану
  и определяются в Compose-теме, чтобы не разошлись.
-->
<resources>
    <color name="surface_base">#FF0B0B0D</color>
    <!-- Подложка иконки. Родственный Void из палитры :core:ui (там #0A0C10),
         но на шаг светлее: на чисто чёрной подложке щит на светлом рабочем
         столе сливался с маской лончера. -->
    <color name="icon_background">#FF12151B</color>
</resources>
