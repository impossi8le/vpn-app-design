<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: отдельные правила для облачного бэкапа и для прямого переноса
  на новое устройство. allowBackup="false" сам по себе не покрывает второй
  случай, а часть OEM игнорирует и его.

  Здесь запрещено всё: в приложении нет данных, которые допустимо переносить.
  Сессия и профиль с приватным ключом привязаны к устройству и к Keystore —
  перенос их бессмысленен и опасен. Смена устройства = повторный вход через бота.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
