<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила для Android 11 и ниже. Пустой список: не переносим ничего.
  Дублирует data_extraction_rules.xml, потому что до Android 12 действует
  именно этот файл.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
