<?xml version="1.0" encoding="utf-8"?>
<!--
  Чтение факта «туннель над трафиком» спрашивает у системы активную сеть и её
  возможности, а для этого нужно `ACCESS_NETWORK_STATE`.

  Разрешение объявлено и в приложении, и в `:vpnservice`, но дублируется здесь
  намеренно: без него инструментальный тест ЭТОГО модуля получает от системы
  `UNKNOWN` на любой запрос, и проверка чтения факта становится бессмысленной.
  Разрешение обычное (не runtime), поэтому дубль ничего не меняет в поведении
  установки и только делает модуль самодостаточным.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
