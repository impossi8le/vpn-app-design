client
dev tun
proto udp
# Адреса заменены на TEST-NET-2 (RFC 5737): не маршрутизируются и не указывают
# на чужую инфраструктуру. В боевом профиле здесь три реальных адреса, port 1194.
remote 198.51.100.10 1194 udp
remote 198.51.100.11 1194 udp
remote 198.51.100.12 1194 udp
remote-random
resolv-retry infinite
nobind
redirect-gateway def1 bypass-dhcp
persist-key
persist-tun
remote-cert-tls server
key-direction 1
data-ciphers AES-256-GCM:AES-128-GCM:AES-256-CBC
data-ciphers-fallback AES-256-CBC
# verb 3 здесь НАМЕРЕННО: боевой профиль просит именно его, а при verb >= 3
# OpenVPN печатает тела PEM, то есть приватный ключ уезжает в logcat.
# CoreConfig.fromProfile() обязана это понизить — иначе утечка на каждом запуске.
verb 3

